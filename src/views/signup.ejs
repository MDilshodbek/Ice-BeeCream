<%- include('includes/header') %> 

<link rel="stylesheet" type="text/css" href="/adminRouter/css/signup.css" />

<body>
  <div class="signup-container">
    <form
      onsubmit="return validateSignupForm()"
      action="/adminRouter/signup"
      method="POST"
      enctype="multipart/form-data"
    >
      <div class="signup-frame" style="width: 650px">
        <div class="signup-top">
          <span>Signup</span>
          <div>
            Go back <a href="/adminRouter">Home</a>
          </div>
          <p>
            Already signed up?
            <a href="/adminRouter/login">Login</a>
          </p>
        </div>

        <!-- Signup inputs -->
        <div class="sign-input-frame" style="justify-content: space-between">
          <div class="sign-up-frame">
            <label>Cafe *</label>
            <input type="text" name="memberNick" class="member-nick" placeholder="Username" />
          </div>
          <div class="sign-up-frame">
            <label>Phone *</label>
            <input type="text" name="memberPhone" class="member-phone" placeholder="Phone" />
          </div>
        </div>

        <div class="sign-input-frame" style="justify-content: space-between">
          <div class="sign-up-frame">
            <label>Password *</label>
            <input type="password" name="memberPassword" class="member-password" placeholder="Password" />
          </div>
          <div class="sign-up-frame">
            <label>Repeat password *</label>
            <input type="password" name="confirmPassword" class="confirm-password" placeholder="Repeat password" />
          </div>
        </div>

        <!-- Signup image -->
        <div class="signup-input-frame">
          <div class="media-frame">
            <img class="upload-img-frame" src="/adminRouter/img/shop2.png" />
            <div class="upload-container">
              <span class="media-text">Product image</span>
              <div class="file-box bs3-primary preview-image" style="margin-top: 25px; display: flex">
                <input class="upload-name" value="Choose image" disabled="disabled" />
                <label for="input-file" class="file-input-label">Upload Image</label>
                <input type="file" id="input-file" class="upload-hidden form-control-file member-image" name="memberImage" />
              </div>
              <p class="thumbnail-desc">
                Please upload cafe image.<br />
                Only .jpg, .jpeg, or .png allowed!
              </p>
            </div>
          </div>
        </div>

        <input name="memberType" value="ADMIN" hidden />

        <!-- Signup button -->
        <button class="signup-btn btn" name="signup" type="submit">Signup</button>

        <!-- Signup with Google -->
        <div class="google-login">
          <a href="/auth/google" class="google-btn">
            <img class="google-icon" src="/adminRouter/img/google.png" alt="Google Icon" />
            <span>Signup with Google</span>
          </a>
        </div>
      </div>
    </form>
  </div>

  <script type="text/javascript" src="/adminRouter/js/signup.js"></script>
</body>

<%- include('includes/footer') %>
