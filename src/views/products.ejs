<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/adminRouter/css/products.css" />

<body>
  <div class="products-container">
    <div class="navigation-menu">
      <ul class="nav justify-content-center">
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link active" href="/adminRouter/">Home</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/adminRouter/product/all">Menu</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/adminRouter/user/all">Users</a>
        </li>
        <li
          class="nav-item"
          style="cursor: pointer"
          onclick="return confirm('Do you want to logout?')"
        >
          <a class="nav-link" href="/adminRouter/logout">Logout</a>
        </li>
      </ul>
    </div>

    <!-- Toggle Buttons Section -->
    <div class="menu-toggle-section">
      <button class="toggle-btn active" id="cafe-menu-btn">Cafe Menu</button>
      <button class="toggle-btn" id="flavor-list-btn">Flavor List</button>
    </div>

    <div class="cafe-menu-frame">
      <div class="board">
        <!-- Cafe Menu Section -->
        <div class="cafe-menu-section active">
          <div class="dishes-table">
            <span class="new-dish-txt" style="margin-bottom: 30px">
              CAFE MENU
            </span>
            <table class="table table-bordered table-hover">
              <thead class="thead-light">
                <tr class="thead-light">
                  <th scope="col">T/r</th>
                  <th scope="col">Product Name</th>
                  <th scope="col">Product Type</th>
                  <th scope="col">Product Size</th>
                  <th scope="col">Product Price</th>
                  <th scope="col">Product Left Count</th>
                  <th scope="col">Status</th>
                </tr>
              </thead>
              <!--  LOOP PRODUCTS: START  -->
              <% products.map(function(value, key) {%>
              <tbody style="background: white">
                <td><%= key + 1 %></td>
                <td><%= value.productName %></td>
                <td><%= value.productCollection %></td>
                <td>
                 <%= value.productCollection === 'CAKE' ? value.cakeSize : value.productSize %>
                </td>
                <td><%= value.productPrice %></td>
                <td><%= value.productLeftCount %></td>
                <td>
                  <select class="spec-select new-product-status" id="<%= value._id%>" data-type="product">
                    <option value="PAUSE" <%= value.productStatus === 'PAUSE' ? 'selected' : ''%>>PAUSE</option>
                    <option value="PROCESS" <%= value.productStatus === 'PROCESS' ? 'selected' : ''%>>PROCESS</option>
                    <option value="DELETE" <%= value.productStatus === 'DELETE' ? 'selected' : ''%>>DELETE</option>
                  </select>
                </td>
              </tbody>
              <%})%>
              <!--  LOOP PRODUCTS: END  -->
            </table>
            <div
              class="long-input"
              style="align-items: flex-end; margin-bottom: 25px"
            >
              <button class="btn btn-primary" id="product-btn">
                New Product
              </button>
            </div>
          </div>

          <form
          id="product-form"
          onsubmit="return validateProductForm()"
            action="/adminRouter/product/create"
            method="POST"
            class="dish-container pro-form"
            enctype="multipart/form-data"
          >
            <div class="long-input" style="display: flex; align-items: center">
              <span class="new-dish-txt">NEW PRODUCT DETAIL</span>
            </div>

            <div class="long-input-frame">
              <!-- product Type -->
               <div class="long-input">
                <label>Product Type</label>
                <select class="product-collection" name="productCollection">
                  <option value="ICECREAM" selected>IceCream</option>
                  <option value="SUNDAES">Sundaes</option>
                  <option value="GELATO">Gelato</option>
                  <option value="CAKE">Cake</option>
                  <option value="MILKSHAKES">Milkshakes</option>
                  <option value="OTHERS">Others</option>
                </select>
              </div>
              
              <input
                name="productStatus"
                value="PAUSE"
                class="product-status"
                hidden
              />
            </div>
            <div class="half-input-frame">
              <!-- product name -->
               <div class="half-input">
                <label>Product Name</label>
                <input
                  type="text"
                  placeholder="Name"
                  name="productName"
                  class="product-name"
                />
              </div>
              <!-- product size -->
              <div class="half-input" id="product-collection">
                <label>Product Size</label>
                <select class="product-size" name="productSize">
                  <option value="REGULAR">Regular</option>
                  <option value="LARGE" selected>Large</option>
                </select>
              </div>

              <div class="half-input" id="cakeSize" style="display: none">
                <label>Cake Size</label>
                <select class="cakeSize" name="cakeSize">
                  <option value="SHORT">short cake</option>
                  <option value="FULL" selected>full cake</option>
                </select>
              </div>
            </div>
            <div class="half-input-frame">
              <!-- product price -->
              <div class="half-input">
                <label>Product Price</label>
                <input
                  type="number"
                  placeholder="Price"
                  name="productPrice"
                  class="product-price"
                />
              </div>

              <div class="half-input">
                <label>Product Left Counts</label>
                <input
                  type="number"
                  placeholder="Counts"
                  name="productLeftCount"
                  class="product-left-count"
                />
              </div>
              
            </div>
            <div class="long-input">
              <label>Product Description</label>
              <textarea name="productDesc" class="product-desc"></textarea>
            </div>

            <div class="img-frame">
              <label>Product Images</label>
              <div class="media-frame">
                <div class="upload-img-box">
                  <img src="/adminRouter/img/upload.svg" class="1" id="image-section-1" />
                  <input
                    type="file"
                    id="file"
                    name="productImages"
                    class="image-one"
                    required
                    onchange = "previewFileHandler(this, 1)"
                  />
                </div>
                <div class="upload-img-box">
                  <img src="/adminRouter/img/upload.svg" class="2" id="image-section-2" />
                  <input
                    type="file"
                    id="file"
                    name="productImages"
                    class="image-two"
                    onchange = "previewFileHandler(this, 2)"
                  />
                </div>
                <div class="upload-img-box">
                  <img src="/adminRouter/img/upload.svg" class="3" id="image-section-3" />
                  <input
                    type="file"
                    id="file"
                    name="productImages"
                    class="image-three"
                    onchange = "previewFileHandler(this, 3)"
                  />
                </div>
                <div class="upload-img-box">
                  <img src="/adminRouter/img/upload.svg" class="4" id="image-section-4" />
                  <input
                    type="file"
                    id="file"
                    name="productImages"
                    class="image-four"
                    onchange = "previewFileHandler(this, 4)"
                  />
                </div>
                <div class="upload-img-box">
                  <img src="/adminRouter/img/upload.svg" class="5" id="image-section-5" />
                  <input
                    type="file"
                    id="file"
                    name="productImages"
                    class="image-five"
                    onchange = "previewFileHandler(this, 5)"
                  />
                </div>
                <input name="restaurantIid" class="restaurant-id" hidden />
              </div>
            </div>

            <div class="operation-buttons">
              <button class="btn btn-danger" id="product-cancel-btn">Cancel</button>
              <button type="submit" class="btn btn-primary" id="product-create-btn">
                Create
              </button>
            </div>
          </form>
        </div>

        <!-- Flavor List Section -->
        <div class="flavor-list-section">
          <div class="dishes-table">
            <span class="new-dish-txt" style="margin-bottom: 30px">
              FLAVOR LIST
            </span>
            <table class="table table-bordered table-hover">
              <thead class="thead-light">
                <tr class="thead-light">
                  <th scope="col">T/r</th>
                  <th scope="col">Flavor Name</th>
                  <th scope="col">Flavor Type</th>
                  <th scope="col">Flavor Price</th>
                  <th scope="col">Status</th>
                </tr>
              </thead>
              <!--  LOOP PRODUCTS: START  -->
              <% flavors.map(function(value, key) {%>
              <tbody style="background: white">
                <td><%= key + 1 %></td>
                <td><%= value.flavorName %></td>
                <td><%= value.flavorCollection %></td>
                <td><%= value.flavorPrice %></td>
                <td>
                  <select class="spec-select new-product-status" id="<%= value._id%>" data-type="flavor">
                    <option value="AVAILABLE" <%= value.flavorStatus === 'AVAILABLE' ? 'selected' : ''%>>AVAILABLE</option>
                    <option value="SOLDOUT" <%= value.flavorStatus === 'SOLDOUT' ? 'selected' : ''%>>SOLDOUT</option>
                  </select>
                </td>
              </tbody>
              <%})%>
              <!--  LOOP PRODUCTS: END  -->
            </table>
            <div
              class="long-input"
              style="align-items: flex-end; margin-bottom: 25px"
            >
              <button class="btn btn-success" id="flavor-btn">
                New Flavor
              </button>
            </div>
          </div>

          <form
    id="flavor-form"
    onsubmit="return validateFlavorForm()"
    action="/adminRouter/flavor/create"
    method="POST"
    class="dish-container taste-form"
    enctype="multipart/form-data"
  >
    <div class="long-input" style="display: flex; align-items: center">
      <span class="new-dish-txt">NEW FLAVOR DETAIL</span>
    </div>
    
    <div class="login-input-frame">
      <!-- Hidden status field with proper name -->
      <input
        name="flavorStatus"
        value="AVAILABLE"
        class="product-status"
        hidden
      />
    </div>
    
    <div class="long-input-frame">
      <!-- Flavor Collection -->
      <div class="long-input">
        <label>Flavor Type</label>
        <select class="product-collection" name="flavorCollection">
          <option value="ICECREAM" selected>IceCream</option>
          <option value="GELATO">Gelato</option>
        </select>
      </div> 
    </div>
    
    <div class="half-input-frame">
      <!-- Flavor name with proper name attribute -->
      <div class="half-input">
        <label>Flavor Name</label>
        <input
          type="text"
          placeholder="Name"
          name="flavorName"
          class="product-name"
        />
      </div>

      <!-- Flavor price with proper name attribute -->
      <div class="half-input">
        <label>Flavor Price</label>
        <input
          type="text"
          placeholder="Price"
          name="flavorPrice"
          class="product-price"
        />
      </div>
    </div>

    <div class="img-frame">
      <label>Product Image</label>
      <div class="flavorMedia-frame">
        <div class="upload-img-box">
          <img src="/adminRouter/img/upload.svg" id="image-flavor-1" />
          <input
            type="file"
            id="file"
            name="flavorImage"
            class="image-one"
            required
            onchange="previewFileHandlerForFlavor(this)"
          />
        </div>
        <input name="restaurantIid" class="restaurant-id" hidden />
      </div>
    </div>

    <div class="operation-buttons">
      <button class="btn btn-danger" id="flavor-cancel-btn" type="button">Cancel</button>
      <button type="submit" class="btn btn-primary" id="flavor-create-btn">
        Create
      </button>
    </div>
  </form>
        </div>

      </div>
    </div>
  </div>

  <script type="text/javascript" src="/adminRouter/js/products.js"></script>
</body>

<%- include('includes/footer') %>