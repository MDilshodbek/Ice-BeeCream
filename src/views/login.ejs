<%- include('includes/header') %>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Berkshire+Swash&family=Archivo:wght@400;600;700&display=swap"
  rel="stylesheet"
/>

<link rel="stylesheet" type="text/css" href="/adminRouter/css/login.css" />

<body>
  <div class="login-wrapper">

    <form
      class="login-container"
      action="/adminRouter/login"
      method="POST"
      novalidate
    >
      <div class="login-frame">
        <div class="login-top">
          <span class="enter-title">Enter</span>
          <div class="nav-links">Go back <a href="/adminRouter">Home</a></div>
          <p class="nav-links">
            Not registered yet?
            <a href="/adminRouter/signup">Signup</a>
          </p>
        </div>

        <div class="login-input-frame">
          <div class="login-input-container">
            <label>Cafe *</label>
            <input
              type="text"
              name="memberNick"
              class="member-nick"
              placeholder="Username"
              required
            />
          </div>
          <div class="login-input-container">
            <label>Password *</label>
            <input
              type="password"
              name="memberPassword"
              class="member-password"
              placeholder="Password"
              required
            />
          </div>
        </div>

        <button class="login-btn btn" name="login" type="submit">Login</button>

        <!-- Google Login Button -->
        <div class="google-login">
          <a href="/auth/google" class="google-btn">
            <img class="google-icon" src="/adminRouter/img/google.png" alt="Google Icon" />
            <span>Login with Google</span>
          </a>
        </div>
      </div>
    </form>
  </div>
</body>

<%- include('includes/footer') %>
